From 041eb1f8450c7b2d42c9415dc3879e1f312a1426 Mon Sep 17 00:00:00 2001
From: Kacper Goc <11682528+BurninChrome@users.noreply.github.com>
Date: Wed, 14 Oct 2026 12:00:00 +0200
Subject: [PATCH] ASoC: codecs: lpass-rx-macro: revert PM clock framework
 conversion

On ASUS Vivobook S 15 (X1E80100) Linux 7.3 breaks SoundWire after the
first runtime suspend of a bus: "qcom_swrm_irq_handler: SWR bus clsh
detected" on swr0/swr1, wsa884x "Parity error detected" / "Test fail for
port:2" / "Reached MAX_RETRY", the WCD938x RX peripheral ends up
UNATTACHED and the speakers stay silent while the PCM keeps running.

7.3 converted the LPASS macro codecs to the PM clock framework: runtime
suspend now gates every macro clock (macro, dcodec, mclk, npl, fsgen),
including the core clocks that used to stay enabled for the lifetime of
the device, and the autosuspend delay dropped from 3000 ms to 100 ms.
The SoundWire master clocked by the macro resumes from clock stop
without re-initialising itself (drivers/soundwire/qcom.c,
swrm_runtime_resume), which no longer works once the whole macro has
been gated in between.

Keeping the macros runtime-active (power/control=on via udev) makes the
problem disappear on this machine, and 7.2.9 with the old clock handling
showed no errors over 14 boots with the same device tree. Restore the
7.2.9 clock handling of this driver: macro and dcodec clocks enabled at
probe and kept on, mclk/npl/fsgen toggled in runtime PM, autosuspend
3000 ms.

Also drops the 7.3 propagation of regcache_sync() errors from
rx_macro_mclk_enable(), which depends on the converted code.

Downstream workaround for the vivobook kernel; not intended for
upstream as is. The proper upstream fix is either to keep the core
clocks out of pm_clk or to make swrm_runtime_resume re-initialise the
controller when its clock parent was gated.

Link: https://ratatoskr.run/linux-sound/2026/07/17200618/t
Assisted-by: LLM (Claude Opus 5.5)
---
 sound/soc/codecs/lpass-rx-macro.c | 137 +++++++++++++++++-------------
 1 file changed, 78 insertions(+), 59 deletions(-)

diff --git a/sound/soc/codecs/lpass-rx-macro.c b/sound/soc/codecs/lpass-rx-macro.c
index 282a6aaa9..6233aa9f5 100644
--- a/sound/soc/codecs/lpass-rx-macro.c
+++ b/sound/soc/codecs/lpass-rx-macro.c
@@ -6,7 +6,6 @@
 #include <linux/init.h>
 #include <linux/io.h>
 #include <linux/platform_device.h>
-#include <linux/pm_clock.h>
 #include <linux/pm_runtime.h>
 #include <linux/clk.h>
 #include <sound/soc.h>
@@ -2031,10 +2030,9 @@ static struct snd_soc_dai_driver rx_macro_dai[] = {
 	},
 };
 
-static int rx_macro_mclk_enable(struct rx_macro *rx, bool mclk_enable)
+static void rx_macro_mclk_enable(struct rx_macro *rx, bool mclk_enable)
 {
 	struct regmap *regmap = rx->regmap;
-	int ret;
 
 	if (mclk_enable) {
 		if (rx->rx_mclk_users == 0) {
@@ -2049,16 +2047,14 @@ static int rx_macro_mclk_enable(struct rx_macro *rx, bool mclk_enable)
 					   CDC_RX_FS_MCLK_CNT_EN_MASK,
 					   CDC_RX_FS_MCLK_CNT_ENABLE);
 			regcache_mark_dirty(regmap);
-			ret = regcache_sync(regmap);
-			if (ret)
-				return ret;
+			regcache_sync(regmap);
 		}
 		rx->rx_mclk_users++;
 	} else {
 		if (rx->rx_mclk_users <= 0) {
 			dev_err(rx->dev, "%s: clock already disabled\n", __func__);
 			rx->rx_mclk_users = 0;
-			return 0;
+			return;
 		}
 		rx->rx_mclk_users--;
 		if (rx->rx_mclk_users == 0) {
@@ -2072,8 +2068,6 @@ static int rx_macro_mclk_enable(struct rx_macro *rx, bool mclk_enable)
 					   CDC_RX_CLK_MCLK2_EN_MASK, 0x0);
 		}
 	}
-
-	return 0;
 }
 
 static int rx_macro_mclk_event(struct snd_soc_dapm_widget *w,
@@ -2085,9 +2079,11 @@ static int rx_macro_mclk_event(struct snd_soc_dapm_widget *w,
 
 	switch (event) {
 	case SND_SOC_DAPM_PRE_PMU:
-		return rx_macro_mclk_enable(rx, true);
+		rx_macro_mclk_enable(rx, true);
+		break;
 	case SND_SOC_DAPM_POST_PMD:
-		return rx_macro_mclk_enable(rx, false);
+		rx_macro_mclk_enable(rx, false);
+		break;
 	default:
 		dev_err(component->dev, "%s: invalid DAPM event %d\n", __func__, event);
 		ret = -EINVAL;
@@ -3675,16 +3671,14 @@ static int swclk_gate_enable(struct clk_hw *hw)
 	struct rx_macro *rx = to_rx_macro(hw);
 	int ret;
 
-	ret = pm_runtime_resume_and_get(rx->dev);
-	if (ret < 0)
-		return ret;
-
-	ret = rx_macro_mclk_enable(rx, true);
+	ret = clk_prepare_enable(rx->mclk);
 	if (ret) {
-		clk_disable_unprepare(rx->mclk);
+		dev_err(rx->dev, "unable to prepare mclk\n");
 		return ret;
 	}
 
+	rx_macro_mclk_enable(rx, true);
+
 	regmap_update_bits(rx->regmap, CDC_RX_CLK_RST_CTRL_SWR_CONTROL,
 			   CDC_RX_SWR_CLK_EN_MASK, 1);
 
@@ -3699,7 +3693,7 @@ static void swclk_gate_disable(struct clk_hw *hw)
 			   CDC_RX_SWR_CLK_EN_MASK, 0);
 
 	rx_macro_mclk_enable(rx, false);
-	pm_runtime_put_autosuspend(rx->dev);
+	clk_disable_unprepare(rx->mclk);
 }
 
 static int swclk_gate_is_enabled(struct clk_hw *hw)
@@ -3870,31 +3864,28 @@ static int rx_macro_probe(struct platform_device *pdev)
 	rx->dev = dev;
 
 	/* set MCLK and NPL rates */
-	ret = clk_set_rate(rx->mclk, MCLK_FREQ);
-	if (ret)
-		return ret;
+	clk_set_rate(rx->mclk, MCLK_FREQ);
+	clk_set_rate(rx->npl, MCLK_FREQ);
 
-	ret = clk_set_rate(rx->npl, MCLK_FREQ);
+	ret = clk_prepare_enable(rx->macro);
 	if (ret)
 		return ret;
 
-	ret = devm_pm_clk_create(dev);
+	ret = clk_prepare_enable(rx->dcodec);
 	if (ret)
-		return ret;
+		goto err_dcodec;
 
-	ret = of_pm_clk_add_clks(dev);
-	if (ret < 0)
-		return ret;
+	ret = clk_prepare_enable(rx->mclk);
+	if (ret)
+		goto err_mclk;
 
-	pm_runtime_set_autosuspend_delay(dev, 100);
-	pm_runtime_use_autosuspend(dev);
-	ret = devm_pm_runtime_enable(dev);
+	ret = clk_prepare_enable(rx->npl);
 	if (ret)
-		return ret;
+		goto err_npl;
 
-	ret = pm_runtime_resume_and_get(dev);
+	ret = clk_prepare_enable(rx->fsgen);
 	if (ret)
-		return ret;
+		goto err_fsgen;
 
 	/* reset swr block  */
 	regmap_update_bits(rx->regmap, CDC_RX_CLK_RST_CTRL_SWR_CONTROL,
@@ -3911,25 +3902,46 @@ static int rx_macro_probe(struct platform_device *pdev)
 					      rx_macro_dai,
 					      ARRAY_SIZE(rx_macro_dai));
 	if (ret)
-		goto err_rpm_put;
+		goto err_clkout;
+
+
+	pm_runtime_set_autosuspend_delay(dev, 3000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_mark_last_busy(dev);
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
 
 	ret = rx_macro_register_mclk_output(rx);
 	if (ret)
-		goto err_rpm_put;
-
-	ret = pm_runtime_put_autosuspend(dev);
-	if (ret < 0)
-		dev_warn(dev, "runtime PM put failed after probe: %d\n", ret);
+		goto err_clkout;
 
 	return 0;
 
-err_rpm_put:
-	if (pm_runtime_put_sync_suspend(dev) < 0)
-		dev_warn(dev, "runtime PM sync suspend failed in probe unwind\n");
+err_clkout:
+	clk_disable_unprepare(rx->fsgen);
+err_fsgen:
+	clk_disable_unprepare(rx->npl);
+err_npl:
+	clk_disable_unprepare(rx->mclk);
+err_mclk:
+	clk_disable_unprepare(rx->dcodec);
+err_dcodec:
+	clk_disable_unprepare(rx->macro);
 
 	return ret;
 }
 
+static void rx_macro_remove(struct platform_device *pdev)
+{
+	struct rx_macro *rx = dev_get_drvdata(&pdev->dev);
+
+	clk_disable_unprepare(rx->mclk);
+	clk_disable_unprepare(rx->npl);
+	clk_disable_unprepare(rx->fsgen);
+	clk_disable_unprepare(rx->macro);
+	clk_disable_unprepare(rx->dcodec);
+}
+
 static const struct of_device_id rx_macro_dt_match[] = {
 	{
 		.compatible = "qcom,sc7280-lpass-rx-macro",
@@ -3957,18 +3969,14 @@ MODULE_DEVICE_TABLE(of, rx_macro_dt_match);
 static int rx_macro_runtime_suspend(struct device *dev)
 {
 	struct rx_macro *rx = dev_get_drvdata(dev);
-	int ret;
 
 	regcache_cache_only(rx->regmap, true);
-
-	ret = pm_clk_suspend(dev);
-	if (ret) {
-		regcache_cache_only(rx->regmap, false);
-		return ret;
-	}
-
 	regcache_mark_dirty(rx->regmap);
 
+	clk_disable_unprepare(rx->fsgen);
+	clk_disable_unprepare(rx->npl);
+	clk_disable_unprepare(rx->mclk);
+
 	return 0;
 }
 
@@ -3977,23 +3985,33 @@ static int rx_macro_runtime_resume(struct device *dev)
 	struct rx_macro *rx = dev_get_drvdata(dev);
 	int ret;
 
-	ret = pm_clk_resume(dev);
+	ret = clk_prepare_enable(rx->mclk);
 	if (ret) {
-		regcache_cache_only(rx->regmap, true);
-		regcache_mark_dirty(rx->regmap);
+		dev_err(dev, "unable to prepare mclk\n");
 		return ret;
 	}
 
-	regcache_cache_only(rx->regmap, false);
-	ret = regcache_sync(rx->regmap);
+	ret = clk_prepare_enable(rx->npl);
 	if (ret) {
-		regcache_cache_only(rx->regmap, true);
-		regcache_mark_dirty(rx->regmap);
-		pm_clk_suspend(dev);
-		return ret;
+		dev_err(dev, "unable to prepare mclkx2\n");
+		goto err_npl;
+	}
+
+	ret = clk_prepare_enable(rx->fsgen);
+	if (ret) {
+		dev_err(dev, "unable to prepare fsgen\n");
+		goto err_fsgen;
 	}
+	regcache_cache_only(rx->regmap, false);
+	regcache_sync(rx->regmap);
 
 	return 0;
+err_fsgen:
+	clk_disable_unprepare(rx->npl);
+err_npl:
+	clk_disable_unprepare(rx->mclk);
+
+	return ret;
 }
 
 static const struct dev_pm_ops rx_macro_pm_ops = {
@@ -4008,6 +4026,7 @@ static struct platform_driver rx_macro_driver = {
 		.pm = pm_ptr(&rx_macro_pm_ops),
 	},
 	.probe = rx_macro_probe,
+	.remove = rx_macro_remove,
 };
 
 module_platform_driver(rx_macro_driver);
