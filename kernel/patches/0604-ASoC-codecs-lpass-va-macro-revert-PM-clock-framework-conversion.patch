From dd0126143d42112914c1b18091f264ad8e422a9c Mon Sep 17 00:00:00 2001
From: Kacper Goc <11682528+BurninChrome@users.noreply.github.com>
Date: Wed, 14 Oct 2026 12:00:00 +0200
Subject: [PATCH] ASoC: codecs: lpass-va-macro: revert PM clock framework
 conversion

On ASUS Vivobook S 15 (X1E80100) Linux 7.3 breaks SoundWire after the
first runtime suspend of a bus: "qcom_swrm_irq_handler: SWR bus clsh
detected" on swr0/swr1, wsa884x "Parity error detected" / "Test fail for
port:2" / "Reached MAX_RETRY", the WCD938x RX peripheral ends up
UNATTACHED and the speakers stay silent while the PCM keeps running.

7.3 converted the LPASS macro codecs to the PM clock framework: runtime
suspend now gates every macro clock (macro, dcodec, mclk, npl, fsgen),
including the core clocks that used to stay enabled for the lifetime of
the device, and the autosuspend delay dropped from 3000 ms to 100 ms.
The SoundWire master clocked by the macro resumes from clock stop
without re-initialising itself (drivers/soundwire/qcom.c,
swrm_runtime_resume), which no longer works once the whole macro has
been gated in between.

Keeping the macros runtime-active (power/control=on via udev) makes the
problem disappear on this machine, and 7.2.9 with the old clock handling
showed no errors over 14 boots with the same device tree. Restore the
7.2.9 clock handling of this driver: macro and dcodec clocks enabled at
probe and kept on, mclk/npl/fsgen toggled in runtime PM, autosuspend
3000 ms.

Also drops the 7.3 error checks on clk_set_rate() in probe.

Downstream workaround for the vivobook kernel; not intended for
upstream as is. The proper upstream fix is either to keep the core
clocks out of pm_clk or to make swrm_runtime_resume re-initialise the
controller when its clock parent was gated.

Link: https://ratatoskr.run/linux-sound/2026/07/17200618/t
Assisted-by: LLM (Claude Opus 5.5)
---
 sound/soc/codecs/lpass-va-macro.c | 137 ++++++++++++++----------------
 1 file changed, 64 insertions(+), 73 deletions(-)

diff --git a/sound/soc/codecs/lpass-va-macro.c b/sound/soc/codecs/lpass-va-macro.c
index dbc5795b9..58a579882 100644
--- a/sound/soc/codecs/lpass-va-macro.c
+++ b/sound/soc/codecs/lpass-va-macro.c
@@ -10,7 +10,6 @@
 #include <linux/of_clk.h>
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
-#include <linux/pm_clock.h>
 #include <linux/pm_runtime.h>
 #include <linux/regmap.h>
 #include <linux/regulator/consumer.h>
@@ -1352,43 +1351,34 @@ static int fsgen_gate_enable(struct clk_hw *hw)
 {
 	struct va_macro *va = to_va_macro(hw);
 	struct regmap *regmap = va->regmap;
-	int ret, rpm_ret;
+	int ret;
 
-	ret = pm_runtime_resume_and_get(va->dev);
-	if (ret < 0)
-		return ret;
+	if (va->has_swr_master) {
+		ret = clk_prepare_enable(va->mclk);
+		if (ret)
+			return ret;
+	}
 
 	ret = va_macro_mclk_enable(va, true);
-	if (ret) {
-		rpm_ret = pm_runtime_put_autosuspend(va->dev);
-		if (rpm_ret < 0)
-			dev_warn(va->dev,
-				 "runtime PM put failed in fsgen enable unwind: %d\n",
-				 rpm_ret);
-		return ret;
-	}
 	if (va->has_swr_master)
 		regmap_update_bits(regmap, CDC_VA_CLK_RST_CTRL_SWR_CONTROL,
 				   CDC_VA_SWR_CLK_EN_MASK, CDC_VA_SWR_CLK_ENABLE);
 
-	return 0;
+	return ret;
 }
 
 static void fsgen_gate_disable(struct clk_hw *hw)
 {
 	struct va_macro *va = to_va_macro(hw);
 	struct regmap *regmap = va->regmap;
-	int ret;
 
 	if (va->has_swr_master)
 		regmap_update_bits(regmap, CDC_VA_CLK_RST_CTRL_SWR_CONTROL,
 			   CDC_VA_SWR_CLK_EN_MASK, 0x0);
 
 	va_macro_mclk_enable(va, false);
-
-	ret = pm_runtime_put_autosuspend(va->dev);
-	if (ret < 0)
-		dev_warn(va->dev, "runtime PM put failed in fsgen disable: %d\n", ret);
+	if (va->has_swr_master)
+		clk_disable_unprepare(va->mclk);
 }
 
 static int fsgen_gate_is_enabled(struct clk_hw *hw)
@@ -1549,7 +1539,6 @@ static int va_macro_probe(struct platform_device *pdev)
 	void __iomem *base;
 	u32 sample_rate = 0;
 	int ret;
-	int rpm_ret;
 
 	va = devm_kzalloc(dev, sizeof(*va), GFP_KERNEL);
 	if (!va)
@@ -1605,9 +1594,7 @@ static int va_macro_probe(struct platform_device *pdev)
 	va->has_npl_clk = data->has_npl_clk;
 
 	/* mclk rate */
-	ret = clk_set_rate(va->mclk, 2 * VA_MACRO_MCLK_FREQ);
-	if (ret)
-		goto err;
+	clk_set_rate(va->mclk, 2 * VA_MACRO_MCLK_FREQ);
 
 	if (va->has_npl_clk) {
 		va->npl = devm_clk_get(dev, "npl");
@@ -1616,29 +1603,25 @@ static int va_macro_probe(struct platform_device *pdev)
 			goto err;
 		}
 
-		ret = clk_set_rate(va->npl, 2 * VA_MACRO_MCLK_FREQ);
-		if (ret)
-			goto err;
+		clk_set_rate(va->npl, 2 * VA_MACRO_MCLK_FREQ);
 	}
 
-	ret = devm_pm_clk_create(dev);
+	ret = clk_prepare_enable(va->macro);
 	if (ret)
 		goto err;
 
-	ret = of_pm_clk_add_clks(dev);
-	if (ret < 0)
-		goto err;
+	ret = clk_prepare_enable(va->dcodec);
+	if (ret)
+		goto err_dcodec;
 
-	pm_runtime_set_autosuspend_delay(dev, 100);
-	pm_runtime_use_autosuspend(dev);
-	ret = devm_pm_runtime_enable(dev);
+	ret = clk_prepare_enable(va->mclk);
 	if (ret)
-		goto err;
+		goto err_mclk;
 
-	rpm_ret = pm_runtime_resume_and_get(dev);
-	if (rpm_ret < 0) {
-		ret = rpm_ret;
-		goto err;
+	if (va->has_npl_clk) {
+		ret = clk_prepare_enable(va->npl);
+		if (ret)
+			goto err_npl;
 	}
 
 	/**
@@ -1651,7 +1634,7 @@ static int va_macro_probe(struct platform_device *pdev)
 		/* read version from register */
 		ret = va_macro_set_lpass_codec_version(va);
 		if (ret)
-			goto err_rpm_put;
+			goto err_clkout;
 	}
 
 	if (va->has_swr_master) {
@@ -1681,28 +1664,35 @@ static int va_macro_probe(struct platform_device *pdev)
 					      va_macro_dais,
 					      ARRAY_SIZE(va_macro_dais));
 	if (ret)
-		goto err_rpm_put;
+		goto err_clkout;
+
+	pm_runtime_set_autosuspend_delay(dev, 3000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_mark_last_busy(dev);
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
 
 	ret = va_macro_register_fsgen_output(va);
 	if (ret)
-		goto err_rpm_put;
+		goto err_clkout;
 
 	va->fsgen = devm_clk_hw_get_clk(dev, &va->hw, "fsgen");
 	if (IS_ERR(va->fsgen)) {
 		ret = PTR_ERR(va->fsgen);
-		goto err_rpm_put;
+		goto err_clkout;
 	}
 
-	rpm_ret = pm_runtime_put_autosuspend(dev);
-	if (rpm_ret < 0)
-		dev_warn(dev, "runtime PM put failed after probe: %d\n", rpm_ret);
-
 	return 0;
 
-err_rpm_put:
-	rpm_ret = pm_runtime_put_sync_suspend(dev);
-	if (rpm_ret < 0)
-		dev_warn(dev, "runtime PM sync suspend failed in probe unwind: %d\n", rpm_ret);
+err_clkout:
+	if (va->has_npl_clk)
+		clk_disable_unprepare(va->npl);
+err_npl:
+	clk_disable_unprepare(va->mclk);
+err_mclk:
+	clk_disable_unprepare(va->dcodec);
+err_dcodec:
+	clk_disable_unprepare(va->macro);
 err:
 	lpass_macro_pds_exit(va->pds);
 
@@ -1713,23 +1703,27 @@ static void va_macro_remove(struct platform_device *pdev)
 {
 	struct va_macro *va = dev_get_drvdata(&pdev->dev);
 
+	if (va->has_npl_clk)
+		clk_disable_unprepare(va->npl);
+
+	clk_disable_unprepare(va->mclk);
+	clk_disable_unprepare(va->dcodec);
+	clk_disable_unprepare(va->macro);
+
 	lpass_macro_pds_exit(va->pds);
 }
 
 static int va_macro_runtime_suspend(struct device *dev)
 {
 	struct va_macro *va = dev_get_drvdata(dev);
-	int ret;
 
 	regcache_cache_only(va->regmap, true);
+	regcache_mark_dirty(va->regmap);
 
-	ret = pm_clk_suspend(dev);
-	if (ret) {
-		regcache_cache_only(va->regmap, false);
-		return ret;
-	}
+	if (va->has_npl_clk)
+		clk_disable_unprepare(va->npl);
 
-	regcache_mark_dirty(va->regmap);
+	clk_disable_unprepare(va->mclk);
 
 	return 0;
 }
@@ -1737,29 +1731,26 @@ static int va_macro_runtime_suspend(struct device *dev)
 static int va_macro_runtime_resume(struct device *dev)
 {
 	struct va_macro *va = dev_get_drvdata(dev);
-	int ret, sret;
+	int ret;
 
-	ret = pm_clk_resume(dev);
+	ret = clk_prepare_enable(va->mclk);
 	if (ret) {
-		regcache_cache_only(va->regmap, true);
-		regcache_mark_dirty(va->regmap);
+		dev_err(va->dev, "unable to prepare mclk\n");
 		return ret;
 	}
 
-	regcache_cache_only(va->regmap, false);
-
-	ret = regcache_sync(va->regmap);
-	if (ret) {
-		regcache_cache_only(va->regmap, true);
-		regcache_mark_dirty(va->regmap);
-		sret = pm_clk_suspend(dev);
-		if (sret)
-			dev_err(va->dev,
-				"failed to suspend clocks after regcache sync failure: %d\n",
-				sret);
-		return ret;
+	if (va->has_npl_clk) {
+		ret = clk_prepare_enable(va->npl);
+		if (ret) {
+			clk_disable_unprepare(va->mclk);
+			dev_err(va->dev, "unable to prepare npl\n");
+			return ret;
+		}
 	}
 
+	regcache_cache_only(va->regmap, false);
+	regcache_sync(va->regmap);
+
 	return 0;
 }
 
