From a2e56bdc0b65ec8b6bc0b52caccee67835053862 Mon Sep 17 00:00:00 2001
From: Kacper Goc <11682528+BurninChrome@users.noreply.github.com>
Date: Wed, 14 Oct 2026 12:00:00 +0200
Subject: [PATCH] ASoC: codecs: lpass-tx-macro: revert PM clock framework
 conversion

On ASUS Vivobook S 15 (X1E80100) Linux 7.3 breaks SoundWire after the
first runtime suspend of a bus: "qcom_swrm_irq_handler: SWR bus clsh
detected" on swr0/swr1, wsa884x "Parity error detected" / "Test fail for
port:2" / "Reached MAX_RETRY", the WCD938x RX peripheral ends up
UNATTACHED and the speakers stay silent while the PCM keeps running.

7.3 converted the LPASS macro codecs to the PM clock framework: runtime
suspend now gates every macro clock (macro, dcodec, mclk, npl, fsgen),
including the core clocks that used to stay enabled for the lifetime of
the device, and the autosuspend delay dropped from 3000 ms to 100 ms.
The SoundWire master clocked by the macro resumes from clock stop
without re-initialising itself (drivers/soundwire/qcom.c,
swrm_runtime_resume), which no longer works once the whole macro has
been gated in between.

Keeping the macros runtime-active (power/control=on via udev) makes the
problem disappear on this machine, and 7.2.9 with the old clock handling
showed no errors over 14 boots with the same device tree. Restore the
7.2.9 clock handling of this driver: macro and dcodec clocks enabled at
probe and kept on, mclk/npl/fsgen toggled in runtime PM, autosuspend
3000 ms.

Also drops the 7.3 propagation of regcache_sync() errors from
tx_macro_mclk_enable(), which depends on the converted code.

Downstream workaround for the vivobook kernel; not intended for
upstream as is. The proper upstream fix is either to keep the core
clocks out of pm_clk or to make swrm_runtime_resume re-initialise the
controller when its clock parent was gated.

Link: https://ratatoskr.run/linux-sound/2026/07/17200618/t
Assisted-by: LLM (Claude Opus 5.5)
---
 sound/soc/codecs/lpass-tx-macro.c | 128 +++++++++++++++++-------------
 1 file changed, 71 insertions(+), 57 deletions(-)

diff --git a/sound/soc/codecs/lpass-tx-macro.c b/sound/soc/codecs/lpass-tx-macro.c
index a8e83eb60..0cbf50647 100644
--- a/sound/soc/codecs/lpass-tx-macro.c
+++ b/sound/soc/codecs/lpass-tx-macro.c
@@ -6,7 +6,6 @@
 #include <linux/clk.h>
 #include <linux/io.h>
 #include <linux/platform_device.h>
-#include <linux/pm_clock.h>
 #include <linux/pm_runtime.h>
 #include <linux/regmap.h>
 #include <sound/soc.h>
@@ -615,7 +614,6 @@ static int tx_macro_mclk_enable(struct tx_macro *tx,
 				bool mclk_enable)
 {
 	struct regmap *regmap = tx->regmap;
-	int ret;
 
 	if (mclk_enable) {
 		if (tx->tx_mclk_users == 0) {
@@ -628,9 +626,7 @@ static int tx_macro_mclk_enable(struct tx_macro *tx,
 					   CDC_TX_FS_CNT_EN_MASK,
 					   CDC_TX_FS_CNT_ENABLE);
 			regcache_mark_dirty(regmap);
-			ret = regcache_sync(regmap);
-			if (ret)
-				return ret;
+			regcache_sync(regmap);
 		}
 		tx->tx_mclk_users++;
 	} else {
@@ -743,9 +739,11 @@ static int tx_macro_mclk_event(struct snd_soc_dapm_widget *w,
 
 	switch (event) {
 	case SND_SOC_DAPM_PRE_PMU:
-		return tx_macro_mclk_enable(tx, true);
+		tx_macro_mclk_enable(tx, true);
+		break;
 	case SND_SOC_DAPM_POST_PMD:
-		return tx_macro_mclk_enable(tx, false);
+		tx_macro_mclk_enable(tx, false);
+		break;
 	default:
 		break;
 	}
@@ -2151,20 +2149,17 @@ static int swclk_gate_enable(struct clk_hw *hw)
 	struct regmap *regmap = tx->regmap;
 	int ret;
 
-	ret = pm_runtime_resume_and_get(tx->dev);
-	if (ret < 0)
-		return ret;
-
-	ret = tx_macro_mclk_enable(tx, true);
+	ret = clk_prepare_enable(tx->mclk);
 	if (ret) {
-		pm_runtime_put_autosuspend(tx->dev);
+		dev_err(tx->dev, "failed to enable mclk\n");
 		return ret;
 	}
 
+	tx_macro_mclk_enable(tx, true);
+
 	regmap_update_bits(regmap, CDC_TX_CLK_RST_CTRL_SWR_CONTROL,
 			   CDC_TX_SWR_CLK_EN_MASK,
 			   CDC_TX_SWR_CLK_ENABLE);
-
 	return 0;
 }
 
@@ -2177,7 +2172,7 @@ static void swclk_gate_disable(struct clk_hw *hw)
 			   CDC_TX_SWR_CLK_EN_MASK, 0x0);
 
 	tx_macro_mclk_enable(tx, false);
-	pm_runtime_put_autosuspend(tx->dev);
+	clk_disable_unprepare(tx->mclk);
 }
 
 static int swclk_gate_is_enabled(struct clk_hw *hw)
@@ -2320,31 +2315,28 @@ static int tx_macro_probe(struct platform_device *pdev)
 	tx->active_decimator[TX_MACRO_AIF3_CAP] = -1;
 
 	/* set MCLK and NPL rates */
-	ret = clk_set_rate(tx->mclk, MCLK_FREQ);
-	if (ret)
-		goto err;
+	clk_set_rate(tx->mclk, MCLK_FREQ);
+	clk_set_rate(tx->npl, MCLK_FREQ);
 
-	ret = clk_set_rate(tx->npl, MCLK_FREQ);
+	ret = clk_prepare_enable(tx->macro);
 	if (ret)
 		goto err;
 
-	ret = devm_pm_clk_create(dev);
+	ret = clk_prepare_enable(tx->dcodec);
 	if (ret)
-		goto err;
+		goto err_dcodec;
 
-	ret = of_pm_clk_add_clks(dev);
-	if (ret < 0)
-		goto err;
+	ret = clk_prepare_enable(tx->mclk);
+	if (ret)
+		goto err_mclk;
 
-	pm_runtime_set_autosuspend_delay(dev, 100);
-	pm_runtime_use_autosuspend(dev);
-	ret = devm_pm_runtime_enable(dev);
+	ret = clk_prepare_enable(tx->npl);
 	if (ret)
-		goto err;
+		goto err_npl;
 
-	ret = pm_runtime_resume_and_get(dev);
-	if (ret < 0)
-		goto err;
+	ret = clk_prepare_enable(tx->fsgen);
+	if (ret)
+		goto err_fsgen;
 
 
 	/* reset soundwire block */
@@ -2364,21 +2356,30 @@ static int tx_macro_probe(struct platform_device *pdev)
 					      tx_macro_dai,
 					      ARRAY_SIZE(tx_macro_dai));
 	if (ret)
-		goto err_rpm_put;
+		goto err_clkout;
+
+	pm_runtime_set_autosuspend_delay(dev, 3000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_mark_last_busy(dev);
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
 
 	ret = tx_macro_register_mclk_output(tx);
 	if (ret)
-		goto err_rpm_put;
-
-	ret = pm_runtime_put_autosuspend(dev);
-	if (ret < 0)
-		dev_warn(dev, "runtime PM put failed after probe: %d\n", ret);
+		goto err_clkout;
 
 	return 0;
 
-err_rpm_put:
-	if (pm_runtime_put_sync_suspend(dev) < 0)
-		dev_warn(dev, "runtime PM sync suspend failed in probe unwind\n");
+err_clkout:
+	clk_disable_unprepare(tx->fsgen);
+err_fsgen:
+	clk_disable_unprepare(tx->npl);
+err_npl:
+	clk_disable_unprepare(tx->mclk);
+err_mclk:
+	clk_disable_unprepare(tx->dcodec);
+err_dcodec:
+	clk_disable_unprepare(tx->macro);
 err:
 	lpass_macro_pds_exit(tx->pds);
 
@@ -2389,24 +2390,26 @@ static void tx_macro_remove(struct platform_device *pdev)
 {
 	struct tx_macro *tx = dev_get_drvdata(&pdev->dev);
 
+	clk_disable_unprepare(tx->macro);
+	clk_disable_unprepare(tx->dcodec);
+	clk_disable_unprepare(tx->mclk);
+	clk_disable_unprepare(tx->npl);
+	clk_disable_unprepare(tx->fsgen);
+
 	lpass_macro_pds_exit(tx->pds);
 }
 
 static int tx_macro_runtime_suspend(struct device *dev)
 {
 	struct tx_macro *tx = dev_get_drvdata(dev);
-	int ret;
 
 	regcache_cache_only(tx->regmap, true);
-
-	ret = pm_clk_suspend(dev);
-	if (ret) {
-		regcache_cache_only(tx->regmap, false);
-		return ret;
-	}
-
 	regcache_mark_dirty(tx->regmap);
 
+	clk_disable_unprepare(tx->fsgen);
+	clk_disable_unprepare(tx->npl);
+	clk_disable_unprepare(tx->mclk);
+
 	return 0;
 }
 
@@ -2415,23 +2418,34 @@ static int tx_macro_runtime_resume(struct device *dev)
 	struct tx_macro *tx = dev_get_drvdata(dev);
 	int ret;
 
-	ret = pm_clk_resume(dev);
+	ret = clk_prepare_enable(tx->mclk);
 	if (ret) {
-		regcache_cache_only(tx->regmap, true);
-		regcache_mark_dirty(tx->regmap);
+		dev_err(dev, "unable to prepare mclk\n");
 		return ret;
 	}
 
-	regcache_cache_only(tx->regmap, false);
-	ret = regcache_sync(tx->regmap);
+	ret = clk_prepare_enable(tx->npl);
 	if (ret) {
-		regcache_cache_only(tx->regmap, true);
-		regcache_mark_dirty(tx->regmap);
-		pm_clk_suspend(dev);
-		return ret;
+		dev_err(dev, "unable to prepare npl\n");
+		goto err_npl;
+	}
+
+	ret = clk_prepare_enable(tx->fsgen);
+	if (ret) {
+		dev_err(dev, "unable to prepare fsgen\n");
+		goto err_fsgen;
 	}
 
+	regcache_cache_only(tx->regmap, false);
+	regcache_sync(tx->regmap);
+
 	return 0;
+err_fsgen:
+	clk_disable_unprepare(tx->npl);
+err_npl:
+	clk_disable_unprepare(tx->mclk);
+
+	return ret;
 }
 
 static const struct dev_pm_ops tx_macro_pm_ops = {
