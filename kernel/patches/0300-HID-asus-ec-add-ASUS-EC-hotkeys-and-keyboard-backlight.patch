+++ b/drivers/hid/Kconfig
@@ -200,6 +200,23 @@ config HID_ASUS
 	- GL553V series
 	- GL753V series
 
+config HID_ASUS_EC
+	tristate "ASUS EC hotkeys and keyboard backlight on Snapdragon laptops"
+	depends on I2C_HID_CORE
+	depends on LEDS_CLASS
+	help
+	  Support for the embedded controller of ASUS laptops based on
+	  Qualcomm Snapdragon, which is reached through vendor reports of
+	  the I2C HID keyboard. Provides the Fn hotkeys, Fn-lock and the
+	  keyboard backlight as the asus::kbd_backlight LED.
+
+	  Supported devices:
+	  - ASUS Zenbook A14 (UX3407QA)
+	  - ASUS Vivobook S15 (S5507QA)
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called hid-asus-ec.
+
 config HID_AUREAL
 	tristate "Aureal"
 	help
