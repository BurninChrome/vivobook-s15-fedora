 drivers/hid/Makefile      |   1 +
 drivers/hid/hid-asus-ec.c | 404 ++++++++++++++++++++++++++++++++++++++
 3 files changed, 422 insertions(+)
 create mode 100644 drivers/hid/hid-asus-ec.c

diff --git a/drivers/hid/Kconfig b/drivers/hid/Kconfig
