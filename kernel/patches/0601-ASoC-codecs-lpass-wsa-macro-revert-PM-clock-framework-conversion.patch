From 8a12535015dc1661feb28b1be45d5523ef2fcbfc Mon Sep 17 00:00:00 2001
From: Kacper Goc <11682528+BurninChrome@users.noreply.github.com>
Date: Wed, 14 Oct 2026 12:00:00 +0200
Subject: [PATCH] ASoC: codecs: lpass-wsa-macro: revert PM clock framework
 conversion

On ASUS Vivobook S 15 (X1E80100) Linux 7.3 breaks SoundWire after the
first runtime suspend of a bus: "qcom_swrm_irq_handler: SWR bus clsh
detected" on swr0/swr1, wsa884x "Parity error detected" / "Test fail for
port:2" / "Reached MAX_RETRY", the WCD938x RX peripheral ends up
UNATTACHED and the speakers stay silent while the PCM keeps running.

7.3 converted the LPASS macro codecs to the PM clock framework: runtime
suspend now gates every macro clock (macro, dcodec, mclk, npl, fsgen),
including the core clocks that used to stay enabled for the lifetime of
the device, and the autosuspend delay dropped from 3000 ms to 100 ms.
The SoundWire master clocked by the macro resumes from clock stop
without re-initialising itself (drivers/soundwire/qcom.c,
swrm_runtime_resume), which no longer works once the whole macro has
been gated in between.

Keeping the macros runtime-active (power/control=on via udev) makes the
problem disappear on this machine, and 7.2.9 with the old clock handling
showed no errors over 14 boots with the same device tree. Restore the
7.2.9 clock handling of this driver: macro and dcodec clocks enabled at
probe and kept on, mclk/npl/fsgen toggled in runtime PM, autosuspend
3000 ms.

The 7.3 fix that rewrites the cached digital gain after the interpolator
clock is enabled (wsa_macro_enable_interpolator) is kept.

Downstream workaround for the vivobook kernel; not intended for
upstream as is. The proper upstream fix is either to keep the core
clocks out of pm_clk or to make swrm_runtime_resume re-initialise the
controller when its clock parent was gated.

Link: https://ratatoskr.run/linux-sound/2026/07/17200618/t
Assisted-by: LLM (Claude Opus 5.5)
---
 sound/soc/codecs/lpass-wsa-macro.c | 138 +++++++++++++++++------------
 1 file changed, 80 insertions(+), 58 deletions(-)

diff --git a/sound/soc/codecs/lpass-wsa-macro.c b/sound/soc/codecs/lpass-wsa-macro.c
index 38e37908b..0bb733353 100644
--- a/sound/soc/codecs/lpass-wsa-macro.c
+++ b/sound/soc/codecs/lpass-wsa-macro.c
@@ -12,7 +12,6 @@
 #include <linux/clk-provider.h>
 #include <sound/soc.h>
 #include <sound/soc-dapm.h>
-#include <linux/pm_clock.h>
 #include <linux/pm_runtime.h>
 #include <linux/of_platform.h>
 #include <sound/tlv.h>
@@ -2533,13 +2532,15 @@ static const struct snd_soc_dapm_route wsa_audio_map[] = {
 static int wsa_swrm_clock(struct wsa_macro *wsa, bool enable)
 {
 	struct regmap *regmap = wsa->regmap;
-	int ret;
 
 	if (enable) {
-		ret = pm_runtime_resume_and_get(wsa->dev);
-		if (ret < 0)
-			return ret;
+		int ret;
 
+		ret = clk_prepare_enable(wsa->mclk);
+		if (ret) {
+			dev_err(wsa->dev, "failed to enable mclk\n");
+			return ret;
+		}
 		wsa_macro_mclk_enable(wsa, true);
 
 		regmap_update_bits(regmap, CDC_WSA_CLK_RST_CTRL_SWR_CONTROL,
@@ -2550,10 +2551,7 @@ static int wsa_swrm_clock(struct wsa_macro *wsa, bool enable)
 		regmap_update_bits(regmap, CDC_WSA_CLK_RST_CTRL_SWR_CONTROL,
 				   CDC_WSA_SWR_CLK_EN_MASK, 0);
 		wsa_macro_mclk_enable(wsa, false);
-
-		ret = pm_runtime_put_autosuspend(wsa->dev);
-		if (ret < 0)
-			dev_warn(wsa->dev, "runtime PM put failed: %d\n", ret);
+		clk_disable_unprepare(wsa->mclk);
 	}
 
 	return 0;
@@ -2661,7 +2659,7 @@ static int wsa_macro_register_mclk_output(struct wsa_macro *wsa)
 	init.num_parents = 1;
 	wsa->hw.init = &init;
 	hw = &wsa->hw;
-	ret = devm_clk_hw_register(wsa->dev, hw);
+	ret = clk_hw_register(wsa->dev, hw);
 	if (ret)
 		return ret;
 
@@ -2776,31 +2774,28 @@ static int wsa_macro_probe(struct platform_device *pdev)
 	wsa->dev = dev;
 
 	/* set MCLK and NPL rates */
-	ret = clk_set_rate(wsa->mclk, WSA_MACRO_MCLK_FREQ);
-	if (ret)
-		return ret;
+	clk_set_rate(wsa->mclk, WSA_MACRO_MCLK_FREQ);
+	clk_set_rate(wsa->npl, WSA_MACRO_MCLK_FREQ);
 
-	ret = clk_set_rate(wsa->npl, WSA_MACRO_MCLK_FREQ);
+	ret = clk_prepare_enable(wsa->macro);
 	if (ret)
-		return ret;
+		goto err;
 
-	ret = devm_pm_clk_create(dev);
+	ret = clk_prepare_enable(wsa->dcodec);
 	if (ret)
-		return ret;
+		goto err_dcodec;
 
-	ret = of_pm_clk_add_clks(dev);
-	if (ret < 0)
-		return ret;
+	ret = clk_prepare_enable(wsa->mclk);
+	if (ret)
+		goto err_mclk;
 
-	pm_runtime_set_autosuspend_delay(dev, 100);
-	pm_runtime_use_autosuspend(dev);
-	ret = devm_pm_runtime_enable(dev);
+	ret = clk_prepare_enable(wsa->npl);
 	if (ret)
-		return ret;
+		goto err_npl;
 
-	ret = pm_runtime_resume_and_get(dev);
-	if (ret < 0)
-		return ret;
+	ret = clk_prepare_enable(wsa->fsgen);
+	if (ret)
+		goto err_fsgen;
 
 	/* reset swr ip */
 	regmap_update_bits(wsa->regmap, CDC_WSA_CLK_RST_CTRL_SWR_CONTROL,
@@ -2817,67 +2812,93 @@ static int wsa_macro_probe(struct platform_device *pdev)
 					      wsa_macro_dai,
 					      ARRAY_SIZE(wsa_macro_dai));
 	if (ret)
-		goto err_rpm_put;
+		goto err_clkout;
+
+	pm_runtime_set_autosuspend_delay(dev, 3000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_mark_last_busy(dev);
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
 
 	ret = wsa_macro_register_mclk_output(wsa);
 	if (ret)
-		goto err_rpm_put;
-
-	ret = pm_runtime_put_autosuspend(dev);
-	if (ret < 0)
-		dev_warn(dev, "runtime PM put failed after probe: %d\n", ret);
+		goto err_clkout;
 
 	return 0;
-err_rpm_put:
-	if (pm_runtime_put_sync_suspend(dev) < 0)
-		dev_warn(dev, "runtime PM sync suspend failed in probe unwind\n");
+
+err_clkout:
+	clk_disable_unprepare(wsa->fsgen);
+err_fsgen:
+	clk_disable_unprepare(wsa->npl);
+err_npl:
+	clk_disable_unprepare(wsa->mclk);
+err_mclk:
+	clk_disable_unprepare(wsa->dcodec);
+err_dcodec:
+	clk_disable_unprepare(wsa->macro);
+err:
 	return ret;
+
+}
+
+static void wsa_macro_remove(struct platform_device *pdev)
+{
+	struct wsa_macro *wsa = dev_get_drvdata(&pdev->dev);
+
+	clk_disable_unprepare(wsa->macro);
+	clk_disable_unprepare(wsa->dcodec);
+	clk_disable_unprepare(wsa->mclk);
+	clk_disable_unprepare(wsa->npl);
+	clk_disable_unprepare(wsa->fsgen);
 }
 
 static int wsa_macro_runtime_suspend(struct device *dev)
 {
 	struct wsa_macro *wsa = dev_get_drvdata(dev);
-	int ret;
 
 	regcache_cache_only(wsa->regmap, true);
-
-	ret = pm_clk_suspend(dev);
-	if (ret) {
-		regcache_cache_only(wsa->regmap, false);
-		return ret;
-	}
-
 	regcache_mark_dirty(wsa->regmap);
 
+	clk_disable_unprepare(wsa->fsgen);
+	clk_disable_unprepare(wsa->npl);
+	clk_disable_unprepare(wsa->mclk);
+
 	return 0;
 }
 
 static int wsa_macro_runtime_resume(struct device *dev)
 {
 	struct wsa_macro *wsa = dev_get_drvdata(dev);
-	int ret, sret;
+	int ret;
 
-	ret = pm_clk_resume(dev);
+	ret = clk_prepare_enable(wsa->mclk);
 	if (ret) {
-		regcache_cache_only(wsa->regmap, true);
-		regcache_mark_dirty(wsa->regmap);
+		dev_err(dev, "unable to prepare mclk\n");
 		return ret;
 	}
-	regcache_cache_only(wsa->regmap, false);
 
-	ret = regcache_sync(wsa->regmap);
+	ret = clk_prepare_enable(wsa->npl);
 	if (ret) {
-		regcache_cache_only(wsa->regmap, true);
-		regcache_mark_dirty(wsa->regmap);
-		sret = pm_clk_suspend(dev);
-		if (sret)
-			dev_err(dev,
-				"failed to suspend clocks after regcache sync failure: %d\n",
-				sret);
-		return ret;
+		dev_err(dev, "unable to prepare mclkx2\n");
+		goto err_npl;
 	}
 
+	ret = clk_prepare_enable(wsa->fsgen);
+	if (ret) {
+		dev_err(dev, "unable to prepare fsgen\n");
+		goto err_fsgen;
+	}
+
+	regcache_cache_only(wsa->regmap, false);
+	regcache_sync(wsa->regmap);
+
 	return 0;
+err_fsgen:
+	clk_disable_unprepare(wsa->npl);
+err_npl:
+	clk_disable_unprepare(wsa->mclk);
+
+	return ret;
 }
 
 static const struct dev_pm_ops wsa_macro_pm_ops = {
@@ -2911,6 +2932,7 @@ static struct platform_driver wsa_macro_driver = {
 		.pm = pm_ptr(&wsa_macro_pm_ops),
 	},
 	.probe = wsa_macro_probe,
+	.remove = wsa_macro_remove,
 };
 
 module_platform_driver(wsa_macro_driver);
